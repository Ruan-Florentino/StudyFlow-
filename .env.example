# Matriz de ambientes: docs/ENVIRONMENT.md | Rotação de chaves: docs/SECRETS_ROTATION.md
# Nunca commite .env com valores reais.
VITE_BACKEND_URL=your-backend-url
VITE_BACKEND_KEY=your-backend-anon-key

# Checkout web Mercado Pago (opcional — adiar se o premium for só via Play/App Store).
# Ver docs/mercado-pago-setup.md — atualize public.users.plan via webhook após pagamento aprovado.
# VITE_CHECKOUT_PREMIUM_MONTHLY=https://www.mercadopago.com.br/checkout/v1/redirect?pref_id=...
# VITE_CHECKOUT_PREMIUM_YEARLY=
# VITE_CHECKOUT_SUPREMO_MONTHLY=
# VITE_CHECKOUT_SUPREMO_YEARLY=
#
# `true` = checkout chama Edge Function create-mp-preference (usuário logado; preço no servidor).
# VITE_ENABLE_MP_EDGE_CHECKOUT=true
#
# Runtime config de pagamento (src/services/payment/config.ts).
# Chave pública pode ficar no cliente (quando activeProvider='mercadoPago').
# VITE_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ⚠️ Não use VITE_MP_ACCESS_TOKEN em produção pública; use Edge Function/backend.
# VITE_MP_ACCESS_TOKEN=
# VITE_MP_WEBHOOK_URL=https://seu-dominio.com/api/mp/webhook
#
# Edge Function mp-webhook (secrets no Dashboard backend, NUNCA no front):
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
#
# Edge Function create-mp-preference — além do token MP, defina PUBLIC_APP_URL (origem do front, ex. https://app.seudominio.com).
# Opcional: MERCADOPAGO_ENV=sandbox, CHECKOUT_PRICE_PREMIUM_MONTHLY, etc.
# Variáveis server-side (recomendado em produção).
# BACKEND_URL=https://xxxx.backend.co
# BACKEND_KEY=your-backend-anon-key
# SOMENTE backend (nunca expor no cliente):
# BACKEND_SERVICE_ROLE_KEY=your-service-role-key
# Log de eventos de segurança em stdout (JSON lines) se não usar service role no DB:
# SECURITY_EVENTS_STDOUT=true
# Origens extra em Content-Security-Policy (connect-src), CSV — ex.: Mapbox:
# CSP_EXTRA_CONNECT=https://api.mapbox.com,https://events.mapbox.com
# JWT de teste para scripts locais (nunca commitar token real):
# TEST_backend_ACCESS_TOKEN=
# A Vercel injeta VERCEL_OIDC_TOKEN automaticamente para o AI Gateway.
# Fora da Vercel, use uma das opções abaixo. Nunca exponha no prefixo VITE_*.
# AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
# OPENROUTER_API_KEY=your-openrouter-key
# Origins extras permitidas no CORS do servidor (CSV). Opcional.
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com
# Telemetria opcional de agente/debug: só em dev, só se a URL estiver definida.
# Produção nunca envia (código em `src/lib/devAgentLog.ts`).
# VITE_DEBUG_INGEST_URL=http://127.0.0.1:7839/ingest/seu-endpoint
# Teste /api/ai no mount: em prod só se true; em dev desligue com false.
# VITE_OPENROUTER_HEALTHCHECK=false

# E-mail de login que pode abrir o painel DEV em produção (Ctrl+Shift+D). Opcional.
# VITE_DEV_OWNER_EMAIL=dev@example.com
