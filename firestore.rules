rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /users/{userId}
    // Fields:
    //   - name: string (required)
    //   - bio: string (optional)
    //   - profilePic: string (optional)
    //   - xp: number (required)
    //   - level: number (required)
    //   - streak: number (optional)
    //   - league: string (optional, enum: ["Bronze", "Prata", "Ouro", "Diamante"])
    //   - dailyXP: number (optional)
    //   - lastStudyDate: string (optional, ISO 8601)
    //   - dailyGoalMinutes: number (optional)
    //   - coins: number (optional)
    //
    // Sub-collections:
    //   - sessions: StudySession entity
    //   - flashcards: Flashcard entity
    //   - decks: Deck entity
    //   - notes: Note entity
    //   - chatHistory: Message entity
    //   - history: QuestionHistory entity
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          request.auth.token.admin == true);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidString(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
          request.resource.data[field].size() >= minLen &&
          request.resource.data[field].size() <= maxLen);
    }

    function isValidNumber(field, minVal) {
      return request.resource.data[field] is number && request.resource.data[field] >= minVal;
    }

    function isValidOptionalNumber(field, minVal) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is number && request.resource.data[field] >= minVal);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(['name', 'xp', 'level']) &&
        isValidString('name', 1, 100) &&
        isValidNumber('xp', 0) &&
        isValidNumber('level', 1) &&
        isValidOptionalString('bio', 0, 500) &&
        isValidOptionalString('profilePic', 0, 1000) &&
        isValidOptionalNumber('streak', 0) &&
        isValidOptionalNumber('dailyXP', 0) &&
        isValidOptionalNumber('dailyGoalMinutes', 0) &&
        isValidOptionalNumber('coins', 0);
    }

    function isValidSession(data) {
      return hasRequiredFields(['date', 'duration', 'subject']) &&
        isValidNumber('duration', 1) &&
        isValidString('subject', 1, 100);
    }

    function isValidFlashcard(data) {
      return hasRequiredFields(['front', 'back', 'subject', 'deckId']) &&
        isValidString('front', 1, 1000) &&
        isValidString('back', 1, 1000) &&
        isValidString('subject', 1, 100) &&
        isValidString('deckId', 1, 100);
    }

    function isValidDeck(data) {
      return hasRequiredFields(['name', 'subject']) &&
        isValidString('name', 1, 100) &&
        isValidString('subject', 1, 100);
    }

    function isValidNote(data) {
      return hasRequiredFields(['title', 'content', 'subject', 'updatedAt']) &&
        isValidString('title', 1, 200) &&
        isValidString('content', 1, 10000) &&
        isValidString('subject', 1, 100);
    }

    function isValidMessage(data) {
      return hasRequiredFields(['role', 'text', 'timestamp']) &&
        data.role in ['user', 'model'] &&
        isValidString('text', 1, 10000) &&
        (!data.keys().hasAny(['engine']) || data.engine is string);
    }

    function isValidHistory(data) {
      return hasRequiredFields(['questionId', 'userAnswer', 'isCorrect', 'timestamp']) &&
        isValidString('questionId', 1, 100) &&
        request.resource.data.isCorrect is bool;
    }

    function isValidChatSession(data) {
      return request.resource.data.keys().hasAll(['agentId', 'createdAt', 'updatedAt']) &&
        request.resource.data.agentId is string;
    }

    function isValidStudyRoom(data) {
      return hasRequiredFields(['name', 'audio', 'color', 'icon', 'description']) &&
        isValidString('name', 1, 100) &&
        isValidString('audio', 1, 200) &&
        data.color is map &&
        data.color.primary is string &&
        isValidString('description', 1, 500);
    }

    function isValidRoomMessage(data) {
      return hasRequiredFields(['userId', 'userName', 'text', 'timestamp', 'type']) &&
        (data.userId == request.auth.uid || data.userId == 'system') &&
        isValidString('text', 1, 1000) &&
        data.type in ['text', 'system', 'reaction'];
    }

    function isValidRoomPresence(data) {
      return hasRequiredFields(['userId', 'joinedAt', 'lastPing']) &&
        data.userId == request.auth.uid;
    }

    // ===============================================================
    // Match Rules
    // ===============================================================

    match /studyRooms/{roomId} {
      allow read: if true;
      allow create: if isAuthenticated(); // Allow seeding
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidRoomMessage(request.resource.data);
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      }

      match /presence/{userId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) && isValidRoomPresence(request.resource.data);
        allow update: if isOwner(userId) && isValidRoomPresence(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isAdmin();

      match /sessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidSession(request.resource.data);
        allow update: if isOwner(userId) && isValidSession(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /flashcards/{cardId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidFlashcard(request.resource.data);
        allow update: if isOwner(userId) && isValidFlashcard(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /aiConversations/{agentId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /decks/{deckId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidDeck(request.resource.data);
        allow update: if isOwner(userId) && isValidDeck(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidNote(request.resource.data);
        allow update: if isOwner(userId) && isValidNote(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /chatHistory/{messageId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidMessage(request.resource.data);
        allow update: if isOwner(userId) && isValidMessage(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /chatSessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidChatSession(request.resource.data);
        allow update: if isOwner(userId) && isValidChatSession(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();

        match /messages/{messageId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId) && isValidMessage(request.resource.data);
          allow update: if isOwner(userId) && isValidMessage(request.resource.data);
          allow delete: if isOwner(userId) || isAdmin();
        }
      }

      match /history/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidHistory(request.resource.data);
        allow update: if isOwner(userId) && isValidHistory(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /usage/{docId} {
      allow read: if isAuthenticated() && docId.split('_')[0] == request.auth.uid;
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
