{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and progress data",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "User's display name" },
        "bio": { "type": "string", "description": "User's bio" },
        "profilePic": { "type": "string", "description": "URL to profile picture" },
        "xp": { "type": "integer", "description": "Total experience points" },
        "level": { "type": "integer", "description": "User's level" },
        "streak": { "type": "integer", "description": "Current study streak in days" },
        "league": { "type": "string", "enum": ["Bronze", "Prata", "Ouro", "Diamante"], "description": "User's current league" },
        "dailyXP": { "type": "integer", "description": "XP earned today" },
        "lastStudyDate": { "type": "string", "format": "date", "description": "Last date the user studied" },
        "dailyGoalMinutes": { "type": "integer", "description": "Daily study goal in minutes" },
        "coins": { "type": "integer", "description": "User's virtual currency" }
      },
      "required": ["name", "xp", "level"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Record of a study session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "duration": { "type": "integer", "description": "Duration in minutes" },
        "subject": { "type": "string" }
      },
      "required": ["date", "duration", "subject"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "A single flashcard for spaced repetition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "front": { "type": "string" },
        "back": { "type": "string" },
        "subject": { "type": "string" },
        "deckId": { "type": "string" },
        "level": { "type": "string", "enum": ["Novo", "Aprendendo", "Revisando", "Dominado"] },
        "interval": { "type": "integer" },
        "nextReview": { "type": "string", "format": "date-time" },
        "lastReviewed": { "type": "string", "format": "date-time" }
      },
      "required": ["front", "back", "subject", "deckId"]
    },
    "Deck": {
      "title": "Deck",
      "description": "A collection of flashcards",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "subject": { "type": "string" },
        "cardCount": { "type": "integer" },
        "newCards": { "type": "integer" },
        "reviewCards": { "type": "integer" }
      },
      "required": ["name", "subject"]
    },
    "Note": {
      "title": "Note",
      "description": "User's study note",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "subject": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "subject", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message with AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "data": { "type": "object" },
        "engine": { "type": "string" }
      },
      "required": ["role", "text", "timestamp"]
    },
    "QuestionHistory": {
      "title": "QuestionHistory",
      "description": "Record of a question attempt",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "userAnswer": { "type": "integer" },
        "isCorrect": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" },
        "timeSpent": { "type": "integer" }
      },
      "required": ["questionId", "userAnswer", "isCorrect", "timestamp"]
    },
    "StudyRoom": {
      "title": "StudyRoom",
      "description": "A collaborative study room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "vibe": { "type": "string" },
        "youtubeAudioId": { "type": "string" },
        "currentVideoLesson": { "type": "string" },
        "videoStartedAt": { "type": "string", "format": "date-time" },
        "onlineUsers": { "type": "integer" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "youtubeAudioId", "color", "icon"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "A message in a study room chat",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["text", "system", "reaction"] }
      },
      "required": ["userId", "userName", "text", "timestamp", "type"]
    },
    "RoomPresence": {
      "title": "RoomPresence",
      "description": "User presence in a study room",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "lastPing": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "joinedAt", "lastPing"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A conversation session with a specific AI agent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "agentId": { "type": "string", "description": "ID of the agent (TUTOR, COACH, etc)" },
        "title": { "type": "string", "description": "Auto-generated title for the session" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "string" }
      },
      "required": ["agentId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "StudySession",
      "description": "User's study sessions"
    },
    "/users/{userId}/flashcards/{cardId}": {
      "schema": "Flashcard",
      "description": "User's flashcards"
    },
    "/users/{userId}/decks/{deckId}": {
      "schema": "Deck",
      "description": "User's flashcard decks"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "User's notes"
    },
    "/users/{userId}/chatHistory/{messageId}": {
      "schema": "Message",
      "description": "User's AI chat history (legacy flat)"
    },
    "/users/{userId}/chatSessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "User's chat sessions with agents"
    },
    "/users/{userId}/chatSessions/{sessionId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a specific chat session"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "QuestionHistory",
      "description": "User's question solving history"
    },
    "/leaderboard/{userId}": {
      "schema": "User",
      "description": "Public leaderboard data"
    },
    "/studyRooms/{roomId}": {
      "schema": "StudyRoom",
      "description": "Collaborative study rooms"
    },
    "/studyRooms/{roomId}/messages/{messageId}": {
      "schema": "RoomMessage",
      "description": "Messages in a study room"
    },
    "/studyRooms/{roomId}/presence/{userId}": {
      "schema": "RoomPresence",
      "description": "User presence in a study room"
    }
  }
}
